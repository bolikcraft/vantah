<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vantah.App.ViewModels"
        xmlns:v="clr-namespace:Vantah.App.Views"
        xmlns:loc="clr-namespace:Vantah.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="640"
        x:Class="Vantah.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/vantah.ico"
        Title="Vantah" Width="800" Height="800">

  <Window.Styles>
    <!-- Заголовки вкладок во FluentTheme по умолчанию 24px и с зашитой MinHeight. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>

    <!-- Акцентная полоса под выбранной вкладкой (PART_SelectedPipe во FluentTheme) убрана.
         Выбранная вкладка и так отличается цветом текста от остальных.
         Гасим именно Opacity: IsVisible/Height/Background у этой части заданы в шаблоне
         локально, а локальное значение сильнее стиля — такие сеттеры молча не сработают. -->
    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="Opacity" Value="0"/>
    </Style>
  </Window.Styles>

  <!-- Верхняя строка — плашка об обновлении Vantah; она вне логин-гейта и видна и на форме входа. -->
  <Grid RowDefinitions="Auto,*">

    <Border x:Name="UpdateBannerHost" Grid.Row="0"
            Background="#333B82F6" CornerRadius="6" Padding="10" Margin="10,10,10,0"
            IsVisible="{Binding UpdateBanner.IsVisible, FallbackValue=False}">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                Command="{Binding UpdateBanner.DismissCommand}"
                Content="✕"
                Background="Transparent"
                ToolTip.Tip="{Binding [Update_Dismiss], Source={x:Static loc:Localizer.Instance}}"/>
        <Button DockPanel.Dock="Right"
                Command="{Binding UpdateBanner.OpenReleaseCommand}"
                Content="{Binding [Update_Download], Source={x:Static loc:Localizer.Instance}}"/>
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="{Binding UpdateBanner.Text}"/>
      </DockPanel>
    </Border>

    <!-- Пока не выполнен вход — форма входа поверх всего, рабочий UI скрыт.
         Гейт держим на обёртке: у самой LoginView DataContext = Login, и IsLoggedIn
         (свойство MainWindowViewModel) на ней бы не разрешился. -->
    <Border x:Name="LoginGate" Grid.Row="1" IsVisible="{Binding !IsLoggedIn}">
      <v:LoginView DataContext="{Binding Login}"/>
    </Border>

    <!-- Рабочий UI виден только при выполненном входе. -->
    <Grid x:Name="WorkingArea" Grid.Row="1" IsVisible="{Binding IsLoggedIn}">

    <!-- Служебные экраны («Процессы», «Настройки», «Лицензия», «О программе») живут не во вкладках,
         а в меню «☰» и открываются отдельными окнами: в полосе остаются три рабочие вкладки. -->
    <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
      <TabItem Header="{Binding [Tab_Status], Source={x:Static loc:Localizer.Instance}}">
        <v:StatusView DataContext="{Binding Status}"/>
      </TabItem>
      <TabItem Header="{Binding [Tab_Locations], Source={x:Static loc:Localizer.Instance}}">
        <v:LocationsView DataContext="{Binding Locations}"/>
      </TabItem>
      <TabItem Header="{Binding [Tab_Domains], Source={x:Static loc:Localizer.Instance}}">
        <v:DomainsView DataContext="{Binding Domains}"/>
      </TabItem>
    </TabControl>

    <!-- Меню служебных экранов: лежит поверх полосы вкладок TabControl, прижато вправо. -->
    <Button Margin="0,3,12,0"
            Padding="10,2"
            FontSize="16"
            Content="☰"
            Background="Transparent"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            ToolTip.Tip="{Binding [Menu_Tooltip], Source={x:Static loc:Localizer.Instance}}">
      <Button.Flyout>
        <MenuFlyout Placement="BottomEdgeAlignedRight">
          <MenuItem Header="{Binding [Menu_Processes], Source={x:Static loc:Localizer.Instance}}"
                    Click="OnProcessesClick"/>
          <MenuItem Header="{Binding [Menu_Settings], Source={x:Static loc:Localizer.Instance}}"
                    Click="OnSettingsClick"/>
          <Separator/>
          <MenuItem Header="{Binding [Menu_License], Source={x:Static loc:Localizer.Instance}}"
                    Click="OnLicenseClick"/>
          <MenuItem Header="{Binding [Menu_About], Source={x:Static loc:Localizer.Instance}}"
                    Click="OnAboutClick"/>
          <Separator/>
          <MenuItem Header="{Binding [Login_Logout], Source={x:Static loc:Localizer.Instance}}"
                    Click="OnLogoutClick"/>
        </MenuFlyout>
      </Button.Flyout>
    </Button>

    </Grid>

  </Grid>

</Window>
