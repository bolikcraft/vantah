<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vantah.App.ViewModels"
        xmlns:v="clr-namespace:Vantah.App.Views"
        xmlns:loc="clr-namespace:Vantah.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="640"
        x:Class="Vantah.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/vantah.ico"
        Title="Vantah" Width="800" Height="800">

  <Window.Styles>
    <!-- Заголовки вкладок во FluentTheme по умолчанию 24px и с зашитой MinHeight. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>

    <!-- Акцентная полоса под выбранной вкладкой (PART_SelectedPipe во FluentTheme) убрана.
         Выбранная вкладка и так отличается цветом текста от остальных.
         Гасим именно Opacity: IsVisible/Height/Background у этой части заданы в шаблоне
         локально, а локальное значение сильнее стиля — такие сеттеры молча не сработают. -->
    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="Opacity" Value="0"/>
    </Style>
  </Window.Styles>

  <!-- ComboBox языка лежит поверх полосы вкладок TabControl, прижат вправо: одна визуальная строка с меню. -->
  <Grid>

    <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
      <TabItem Header="{Binding [Tab_Status], Source={x:Static loc:Localizer.Instance}}">
        <v:StatusView DataContext="{Binding Status}"/>
      </TabItem>
      <TabItem Header="{Binding [Tab_Locations], Source={x:Static loc:Localizer.Instance}}">
        <v:LocationsView DataContext="{Binding Locations}"/>
      </TabItem>
      <TabItem Header="{Binding [Tab_Domains], Source={x:Static loc:Localizer.Instance}}">
        <v:DomainsView DataContext="{Binding Domains}"/>
      </TabItem>
      <TabItem Header="{Binding [Tab_License], Source={x:Static loc:Localizer.Instance}}">
        <v:LicenseView DataContext="{Binding License}"/>
      </TabItem>
      <TabItem Header="{Binding [Tab_Processes], Source={x:Static loc:Localizer.Instance}}">
        <v:ProcessesView DataContext="{Binding Processes}"/>
      </TabItem>
      <TabItem Header="{Binding [Tab_About], Source={x:Static loc:Localizer.Instance}}">
        <v:AboutView DataContext="{Binding About}"/>
      </TabItem>
      <TabItem Header="{Binding [Tab_Settings], Source={x:Static loc:Localizer.Instance}}">
        <v:ConfigView DataContext="{Binding Config}"/>
      </TabItem>
    </TabControl>

    <!-- Выбор языка интерфейса: применяется на лету и запоминается на следующий запуск. -->
    <ComboBox Margin="0,3,12,0"
              MinWidth="110"
              MinHeight="0"
              Padding="8,2"
              FontSize="13"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              ItemsSource="{Binding Languages}"
              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
              ToolTip.Tip="{Binding [Lang_Label], Source={x:Static loc:Localizer.Instance}}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LanguageOption">
          <TextBlock Text="{Binding Display}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

  </Grid>

</Window>
