<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vantah.App.ViewModels"
        xmlns:v="clr-namespace:Vantah.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="640"
        x:Class="Vantah.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/tray.ico"
        Title="Vantah" Width="800" Height="800">

  <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
    <TabItem Header="Статус"><v:StatusView DataContext="{Binding Status}"/></TabItem>
    <TabItem Header="Локации"><v:LocationsView DataContext="{Binding Locations}"/></TabItem>
    <TabItem Header="Домены"><v:DomainsView DataContext="{Binding Domains}"/></TabItem>
    <TabItem Header="Лицензия"><v:LicenseView DataContext="{Binding License}"/></TabItem>
    <TabItem Header="О программе"><v:AboutView DataContext="{Binding About}"/></TabItem>
    <TabItem Header="Процессы"><v:ProcessesView DataContext="{Binding Processes}"/></TabItem>
  </TabControl>

</Window>
