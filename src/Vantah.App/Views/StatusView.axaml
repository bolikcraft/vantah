<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantah.App.ViewModels"
             xmlns:loc="clr-namespace:Vantah.App.Localization"
             x:DataType="vm:StatusViewModel"
             x:Class="Vantah.App.Views.StatusView">
  <Grid Margin="16" RowDefinitions="Auto,*">
    <!--
      Скелетон вместо блока статуса, пока не пришёл первый ответ CLI: иначе на старте
      секунду висит «Отключено», хотя статус ещё не опрошен. Геометрия плашек повторяет
      реальные строки, чтобы блок не прыгал по высоте при появлении данных.
    -->
    <StackPanel x:Name="StatusSkeleton" Grid.Row="0" Spacing="8" HorizontalAlignment="Center"
                IsVisible="{Binding IsStatusUnknown}">
      <StackPanel.Styles>
        <Style Selector="Border.skeleton">
          <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
          <Setter Property="Opacity" Value="0.15"/>
          <Setter Property="CornerRadius" Value="4"/>
          <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
      </StackPanel.Styles>
      <!-- Первая строка — не плашка, а текст: пользователю должно быть понятно, что происходит. -->
      <TextBlock Text="{Binding [Status_Checking], Source={x:Static loc:Localizer.Instance}}"
                 FontSize="18" FontWeight="SemiBold" Opacity="0.75" Height="30"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Border Classes="skeleton" Width="240" Height="22"/>
      <Border Classes="skeleton" Width="160" Height="20"/>
      <Border Classes="skeleton" Width="160" Height="20"/>
      <Border Classes="skeleton" Width="200" Height="20"/>
      <Border Classes="skeleton" Width="200" Height="20"/>
      <Border Classes="skeleton" Width="180" Height="33" CornerRadius="6"/>
      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <Border Classes="skeleton" Width="120" Height="20"/>
        <Border Classes="skeleton" Width="160" Height="32" CornerRadius="6"/>
      </StackPanel>
    </StackPanel>

    <StackPanel x:Name="StatusBlock" Grid.Row="0" Spacing="8" HorizontalAlignment="Center"
                IsVisible="{Binding !IsStatusUnknown}">
      <TextBlock Text="{Binding ConnectionText}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding Location}" FontSize="16" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding Mode}" Opacity="0.7" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding ExclusionsText}" Opacity="0.7" HorizontalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <TextBlock Text="{Binding [Status_SpeedLabel], Source={x:Static loc:Localizer.Instance}}" Opacity="0.7"/>
        <TextBlock Text="{Binding RxText}"/>
        <TextBlock Text="{Binding TxText}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <TextBlock Text="{Binding [Status_SessionLabel], Source={x:Static loc:Localizer.Instance}}" Opacity="0.7"/>
        <TextBlock Text="{Binding RxTotalText}"/>
        <TextBlock Text="{Binding TxTotalText}"/>
      </StackPanel>
      <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"
              IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Center" Width="180"/>
      <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap" MaxWidth="480"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <TextBlock FontWeight="SemiBold"
                   Text="{Binding [Status_IpVersion], Source={x:Static loc:Localizer.Instance}}"/>
        <ComboBox Width="160" ItemsSource="{Binding IpVersionOptions}"
                  SelectedItem="{Binding SelectedIpVersion}"/>
      </StackPanel>
    </StackPanel>

    <TabControl Grid.Row="1" Margin="0,12,0,0">
      <TabControl.Styles>
        <!-- Заголовки вложенных вкладок (История/Лог) мельче и компактнее. -->
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="20"/>
          <Setter Property="MinHeight" Value="0"/>
          <Setter Property="Padding" Value="8,4"/>
        </Style>
      </TabControl.Styles>
      <TabItem Header="{Binding [Status_SubTab_History], Source={x:Static loc:Localizer.Instance}}">
        <Grid>
          <TextBlock Text="{Binding [Status_HistoryEmpty], Source={x:Static loc:Localizer.Instance}}"
                     Opacity="0.6" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !History.HasHistory}"/>
          <ScrollViewer IsVisible="{Binding History.HasHistory}">
            <ItemsControl ItemsSource="{Binding History.Items}" Margin="4,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="10" Opacity="0.85" Margin="0,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding [Status_SubTab_Log], Source={x:Static loc:Localizer.Instance}}">
        <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" FontFamily="monospace" FontSize="10"
                 BorderThickness="0" Background="Transparent" Padding="0"
                 VerticalContentAlignment="Top" VerticalAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
