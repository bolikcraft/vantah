<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantah.App.ViewModels"
             xmlns:loc="clr-namespace:Vantah.App.Localization"
             x:Class="Vantah.App.Views.ConfigView"
             x:DataType="vm:ConfigViewModel">

  <UserControl.Styles>
    <!-- Карточка секции настроек: фиксированная ширина, чтобы WrapPanel раскладывал их в 2 колонки. -->
    <Style Selector="Border.card">
      <Setter Property="Width" Value="352"/>
      <Setter Property="Margin" Value="0,0,14,14"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#22808080"/>
      <Setter Property="Background" Value="#0DFFFFFF"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="Border.card > StackPanel">
      <Setter Property="Spacing" Value="8"/>
    </Style>
    <Style Selector="Border.card TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14" MaxWidth="746" HorizontalAlignment="Center">

      <!-- Предупреждения — на всю ширину над карточками. -->
      <!-- Смена настроек на живом туннеле применяется, но подхватывается лишь при следующем подключении. -->
      <Border Background="#33F59E0B" CornerRadius="6" Padding="10"
              IsVisible="{Binding IsConnectedWarningVisible}">
        <TextBlock TextWrapping="Wrap"
                   Text="{Binding [Settings_ConnectedWarning], Source={x:Static loc:Localizer.Instance}}"/>
      </Border>

      <Border Background="#333B82F6" CornerRadius="6" Padding="10"
              IsVisible="{Binding IsUpdateAvailable}">
        <TextBlock TextWrapping="Wrap" Text="{Binding UpdateMessage}"/>
      </Border>

      <WrapPanel Orientation="Horizontal">

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="header"
                       Text="{Binding [Lang_Label], Source={x:Static loc:Localizer.Instance}}"/>
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LanguageOption">
                  <TextBlock Text="{Binding Display}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="header"
                       Text="{Binding [Settings_StartupSection], Source={x:Static loc:Localizer.Instance}}"/>
            <CheckBox IsChecked="{Binding AutoConnectEnabled}"
                      Content="{Binding [Settings_AutoConnect], Source={x:Static loc:Localizer.Instance}}"/>
            <StackPanel Margin="24,0,0,0" IsEnabled="{Binding AutoConnectEnabled}">
              <RadioButton GroupName="AutoConnectTarget"
                           IsChecked="{Binding !AutoConnectUseFastest}"
                           Content="{Binding [Settings_AutoConnectLast], Source={x:Static loc:Localizer.Instance}}"/>
              <RadioButton GroupName="AutoConnectTarget"
                           IsChecked="{Binding AutoConnectUseFastest}"
                           Content="{Binding [Settings_AutoConnectFastest], Source={x:Static loc:Localizer.Instance}}"/>
            </StackPanel>
            <CheckBox IsChecked="{Binding AutostartEnabled}"
                      Content="{Binding [Settings_Autostart], Source={x:Static loc:Localizer.Instance}}"/>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="header"
                       Text="{Binding [Settings_Mode], Source={x:Static loc:Localizer.Instance}}"/>
            <ToggleSwitch IsChecked="{Binding IsSocksMode}" OffContent="TUN" OnContent="SOCKS"/>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsSocksMode}">
          <StackPanel>
            <TextBlock Classes="header"
                       Text="{Binding [Settings_SocksSection], Source={x:Static loc:Localizer.Instance}}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="140" Text="{Binding SocksPort}"
                       PlaceholderText="{Binding [Settings_SocksPort], Source={x:Static loc:Localizer.Instance}}"/>
              <Button Command="{Binding ApplySocksPortCommand}"
                      Content="{Binding [Common_Apply], Source={x:Static loc:Localizer.Instance}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="200" Text="{Binding SocksHost}"
                       PlaceholderText="{Binding [Settings_SocksHost], Source={x:Static loc:Localizer.Instance}}"/>
              <Button Command="{Binding ApplySocksHostCommand}"
                      Content="{Binding [Common_Apply], Source={x:Static loc:Localizer.Instance}}"/>
            </StackPanel>
            <TextBox Text="{Binding SocksUsername}"
                     PlaceholderText="{Binding [Settings_SocksUsername], Source={x:Static loc:Localizer.Instance}}"/>
            <TextBox Text="{Binding SocksPassword}" PasswordChar="•"
                     PlaceholderText="{Binding [Settings_SocksPassword], Source={x:Static loc:Localizer.Instance}}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding ApplySocksAuthCommand}"
                      Content="{Binding [Settings_SaveAuth], Source={x:Static loc:Localizer.Instance}}"/>
              <Button Command="{Binding ClearSocksAuthCommand}"
                      Content="{Binding [Settings_ClearAuth], Source={x:Static loc:Localizer.Instance}}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="header"
                       Text="{Binding [Settings_Dns], Source={x:Static loc:Localizer.Instance}}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="224" Text="{Binding DnsUpstream}"
                       PlaceholderText="{Binding [Settings_DnsPlaceholder], Source={x:Static loc:Localizer.Instance}}"/>
              <Button Name="ApplyDnsButton" Command="{Binding ApplyDnsCommand}"
                      Content="{Binding [Common_Apply], Source={x:Static loc:Localizer.Instance}}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="header"
                       Text="{Binding [Settings_Protocol], Source={x:Static loc:Localizer.Instance}}"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding SelectedProtocol}"/>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="header"
                       Text="{Binding [Settings_Channel], Source={x:Static loc:Localizer.Instance}}"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding SelectedChannel}"/>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="header"
                       Text="{Binding [Settings_Routing], Source={x:Static loc:Localizer.Instance}}"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RoutingOptions}" SelectedItem="{Binding SelectedRouting}"/>
            <Button HorizontalAlignment="Stretch" Command="{Binding CreateRouteScriptCommand}" IsEnabled="{Binding !IsBusy}"
                    IsVisible="{Binding IsRouteScriptAvailable}"
                    Content="{Binding [Settings_CreateRouteScript], Source={x:Static loc:Localizer.Instance}}"/>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="6">
            <CheckBox IsChecked="{Binding ChangeSystemDns}"
                      Content="{Binding [Settings_ChangeSystemDns], Source={x:Static loc:Localizer.Instance}}"/>
            <CheckBox IsChecked="{Binding PostQuantum}"
                      Content="{Binding [Settings_PostQuantum], Source={x:Static loc:Localizer.Instance}}"/>
            <CheckBox IsChecked="{Binding ShowNotifications}"
                      Content="{Binding [Settings_ShowNotifications], Source={x:Static loc:Localizer.Instance}}"/>
            <CheckBox IsChecked="{Binding DebugLogging}"
                      Content="{Binding [Settings_DebugLogging], Source={x:Static loc:Localizer.Instance}}"/>
            <CheckBox IsChecked="{Binding CrashReporting}"
                      Content="{Binding [Settings_CrashReporting], Source={x:Static loc:Localizer.Instance}}"/>
            <CheckBox IsChecked="{Binding Telemetry}"
                      Content="{Binding [Settings_Telemetry], Source={x:Static loc:Localizer.Instance}}"/>
            <CheckBox IsChecked="{Binding ShowHints}"
                      Content="{Binding [Settings_ShowHints], Source={x:Static loc:Localizer.Instance}}"/>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="header"
                       Text="{Binding [Settings_InterfaceOverride], Source={x:Static loc:Localizer.Instance}}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="224" Text="{Binding InterfaceOverride}"
                       PlaceholderText="{Binding [Settings_InterfacePlaceholder], Source={x:Static loc:Localizer.Instance}}"/>
              <Button Command="{Binding ApplyInterfaceOverrideCommand}"
                      Content="{Binding [Common_Apply], Source={x:Static loc:Localizer.Instance}}"/>
            </StackPanel>
          </StackPanel>
        </Border>

      </WrapPanel>

      <!-- Действия и статус — на всю ширину под карточками. -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding ReloadCommand}" IsEnabled="{Binding !IsBusy}"
                Content="{Binding [Common_Refresh], Source={x:Static loc:Localizer.Instance}}"/>
        <Button Command="{Binding ExportLogsCommand}" IsEnabled="{Binding !IsBusy}"
                Content="{Binding [Settings_ExportLogs], Source={x:Static loc:Localizer.Instance}}"/>
        <TextBlock VerticalAlignment="Center" Foreground="MediumSeaGreen" Text="{Binding StatusText}"
                   IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </StackPanel>

      <TextBlock Foreground="IndianRed" TextWrapping="Wrap" Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
