<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantah.App.ViewModels"
             x:DataType="vm:HistoryViewModel"
             x:Class="Vantah.App.Views.HistoryView">
  <Grid Margin="16" RowDefinitions="Auto,*">
    <TextBlock Grid.Row="0" Text="Ранее подключались к:" FontWeight="Bold" FontSize="16"
               Margin="0,0,0,8"/>

    <!-- Пустое состояние: пока нет завершённых сессий. -->
    <TextBlock Grid.Row="1" Text="Пока нет записей — история появится после подключений."
               Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Top"
               IsVisible="{Binding !HasHistory}"/>

    <!-- Список завершённых сессий (до 12 строк), прокручиваемый. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  IsVisible="{Binding HasHistory}">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.85" Margin="0,2"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
