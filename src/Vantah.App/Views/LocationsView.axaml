<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantah.App.ViewModels"
             xmlns:loc="clr-namespace:Vantah.App.Localization"
             x:DataType="vm:LocationsViewModel"
             x:Class="Vantah.App.Views.LocationsView">
  <UserControl.Styles>
    <!-- Подсветка активной локации: полупрозрачный акцент, читаемый в обеих темах. -->
    <Style Selector="Border.connected">
      <Setter Property="Background" Value="#3300C853"/>
      <Setter Property="BorderBrush" Value="#8000C853"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- Убираем собственный отступ строки списка, чтобы колонки строк совпали с шапкой. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
    </Style>
    <!-- Плитка-заглушка «скелетона»: нейтральный серый, читаемый в обеих темах, с мягкой пульсацией. -->
    <Style Selector="Border.skeleton">
      <Setter Property="Background" Value="#26808080"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Style.Animations>
        <Animation Duration="0:0:1.3" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.85"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Плоские кнопки-заголовки колонок. -->
    <Style Selector="Button.header">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="12">
    <TextBox DockPanel.Dock="Top" Text="{Binding Search}" Margin="0,0,0,8"
             PlaceholderText="{Binding [Locations_SearchPlaceholder], Source={x:Static loc:Localizer.Instance}}"/>

    <!-- Шапка: те же ColumnDefinitions, что и у строки списка; отступ 4 слева/справа
         компенсирует Padding="4,2" рамки внутри шаблона строки. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="36,34,48,*,*,120,120,110" Margin="4,0,4,4">
      <Button Grid.Column="0" Classes="header" Content="{Binding FavoritesHeader}"
              Command="{Binding ToggleFavoritesFirstCommand}"
              ToolTip.Tip="{Binding [Locations_Tooltip_FavoritesFirst], Source={x:Static loc:Localizer.Instance}}"/>
      <Button Grid.Column="2" Classes="header" Content="{Binding IsoHeader}"
              Command="{Binding SortByCommand}" CommandParameter="Iso"
              ToolTip.Tip="{Binding [Locations_Tooltip_SortByIso], Source={x:Static loc:Localizer.Instance}}"/>
      <Button Grid.Column="3" Classes="header" Content="{Binding CityHeader}"
              Command="{Binding SortByCommand}" CommandParameter="City"
              ToolTip.Tip="{Binding [Locations_Tooltip_SortByCity], Source={x:Static loc:Localizer.Instance}}"/>
      <Button Grid.Column="4" Classes="header" Content="{Binding CountryHeader}"
              Command="{Binding SortByCommand}" CommandParameter="Country"
              ToolTip.Tip="{Binding [Locations_Tooltip_SortByCountry], Source={x:Static loc:Localizer.Instance}}"/>
      <Button Grid.Column="6" Classes="header" Content="{Binding PingHeader}"
              Command="{Binding SortByCommand}" CommandParameter="Ping"
              HorizontalContentAlignment="Right"
              ToolTip.Tip="{Binding [Locations_Tooltip_SortByPing], Source={x:Static loc:Localizer.Instance}}"/>
    </Grid>

    <Grid>
    <ListBox ItemsSource="{Binding Items}" Padding="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LocationItemViewModel">
          <Border Classes.connected="{Binding IsConnected}" CornerRadius="4" Padding="4,2">
            <Grid ColumnDefinitions="36,34,48,*,*,120,120,110">
              <Button Grid.Column="0" Content="{Binding Star}"
                      Command="{Binding $parent[ListBox].((vm:LocationsViewModel)DataContext).ToggleFavoriteCommand}"
                      CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                      VerticalAlignment="Center" Padding="6,2"/>
              <Image Grid.Column="1" Source="{Binding Flag}" Width="24" Height="18"
                     Margin="2,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding IsoCode}" Margin="6,0"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{Binding City}" Margin="6,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="4" Text="{Binding Country}" Foreground="Gray" Margin="6,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="5" Foreground="#00C853" FontWeight="SemiBold"
                         Text="{Binding [Locations_ConnectedBadge], Source={x:Static loc:Localizer.Instance}}"
                         Margin="6,0" VerticalAlignment="Center" IsVisible="{Binding IsConnected}"/>
              <TextBlock Grid.Column="6" Text="{Binding PingMs}" Opacity="0.7" Margin="6,0"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
              <Button Grid.Column="7"
                      Content="{Binding [Common_Connect], Source={x:Static loc:Localizer.Instance}}"
                      Command="{Binding $parent[ListBox].((vm:LocationsViewModel)DataContext).ConnectCommand}"
                      CommandParameter="{Binding}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

      <!-- Пока грузим — строки-«скелетоны», повторяющие раскладку колонок, вместо пустоты. -->
      <ItemsControl IsVisible="{Binding IsLoading}" ItemsSource="{Binding SkeletonRows}"
                    VerticalAlignment="Top"
                    ToolTip.Tip="{Binding [Locations_Loading], Source={x:Static loc:Localizer.Instance}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="36,34,48,*,*,120,120,110" Height="34" Margin="4,3">
              <Border Grid.Column="1" Classes="skeleton" Width="24" Height="16" VerticalAlignment="Center"/>
              <Border Grid.Column="2" Classes="skeleton" Height="12" Margin="6,0" VerticalAlignment="Center"/>
              <Border Grid.Column="3" Classes="skeleton" Height="12" Margin="6,0" VerticalAlignment="Center"/>
              <Border Grid.Column="4" Classes="skeleton" Height="12" Margin="6,0" VerticalAlignment="Center"/>
              <Border Grid.Column="6" Classes="skeleton" Height="12" Width="44" Margin="6,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
              <Border Grid.Column="7" Classes="skeleton" Height="26" Width="92" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Сбой загрузки — текст ошибки и кнопка «Обновить» вместо молчаливой пустоты. -->
      <StackPanel IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="380">
        <TextBlock Text="{Binding LoadError}" Foreground="IndianRed" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
        <Button Command="{Binding ReloadCommand}" HorizontalAlignment="Center"
                Content="{Binding [Common_Refresh], Source={x:Static loc:Localizer.Instance}}"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
