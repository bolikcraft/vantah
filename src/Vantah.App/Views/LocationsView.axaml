<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantah.App.ViewModels"
             x:DataType="vm:LocationsViewModel"
             x:Class="Vantah.App.Views.LocationsView">
  <UserControl.Styles>
    <!-- Подсветка активной локации: полупрозрачный акцент, читаемый в обеих темах. -->
    <Style Selector="Border.connected">
      <Setter Property="Background" Value="#3300C853"/>
      <Setter Property="BorderBrush" Value="#8000C853"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- Убираем собственный отступ строки списка, чтобы колонки строк совпали с шапкой. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
    </Style>
    <!-- Плоские кнопки-заголовки колонок. -->
    <Style Selector="Button.header">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="12">
    <TextBox DockPanel.Dock="Top" PlaceholderText="Поиск локации…" Text="{Binding Search}" Margin="0,0,0,8"/>

    <!-- Шапка: те же ColumnDefinitions, что и у строки списка; отступ 4 слева/справа
         компенсирует Padding="4,2" рамки внутри шаблона строки. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="36,34,48,*,*,120,120,110" Margin="4,0,4,4">
      <Button Grid.Column="0" Classes="header" Content="{Binding FavoritesHeader}"
              Command="{Binding ToggleFavoritesFirstCommand}" ToolTip.Tip="Избранные сверху"/>
      <Button Grid.Column="2" Classes="header" Content="{Binding IsoHeader}"
              Command="{Binding SortByCommand}" CommandParameter="Iso"
              ToolTip.Tip="Сортировать по коду страны"/>
      <Button Grid.Column="3" Classes="header" Content="{Binding CityHeader}"
              Command="{Binding SortByCommand}" CommandParameter="City"
              ToolTip.Tip="Сортировать по городу"/>
      <Button Grid.Column="4" Classes="header" Content="{Binding CountryHeader}"
              Command="{Binding SortByCommand}" CommandParameter="Country"
              ToolTip.Tip="Сортировать по стране"/>
      <Button Grid.Column="6" Classes="header" Content="{Binding PingHeader}"
              Command="{Binding SortByCommand}" CommandParameter="Ping"
              HorizontalContentAlignment="Right" ToolTip.Tip="Сортировать по пингу"/>
    </Grid>

    <ListBox ItemsSource="{Binding Items}" Padding="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LocationItemViewModel">
          <Border Classes.connected="{Binding IsConnected}" CornerRadius="4" Padding="4,2">
            <Grid ColumnDefinitions="36,34,48,*,*,120,120,110">
              <Button Grid.Column="0" Content="{Binding Star}"
                      Command="{Binding $parent[ListBox].((vm:LocationsViewModel)DataContext).ToggleFavoriteCommand}"
                      CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                      VerticalAlignment="Center" Padding="6,2"/>
              <Image Grid.Column="1" Source="{Binding Flag}" Width="24" Height="18"
                     Margin="2,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding IsoCode}" Margin="6,0"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{Binding City}" Margin="6,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="4" Text="{Binding Country}" Foreground="Gray" Margin="6,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="5" Text="✓ Подключено" Foreground="#00C853" FontWeight="SemiBold"
                         Margin="6,0" VerticalAlignment="Center" IsVisible="{Binding IsConnected}"/>
              <TextBlock Grid.Column="6" Text="{Binding PingMs}" Opacity="0.7" Margin="6,0"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
              <Button Grid.Column="7" Content="Подключить"
                      Command="{Binding $parent[ListBox].((vm:LocationsViewModel)DataContext).ConnectCommand}"
                      CommandParameter="{Binding}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
