<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantah.App.ViewModels"
             xmlns:loc="clr-namespace:Vantah.App.Localization"
             x:DataType="vm:LoginViewModel"
             x:Class="Vantah.App.Views.LoginView">
  <StackPanel Margin="32" Spacing="16" MaxWidth="380"
              HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="{Binding [Login_Title], Source={x:Static loc:Localizer.Instance}}"
               FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>

    <!-- До старта: пояснение + «Войти» -->
    <StackPanel Spacing="16" IsVisible="{Binding !IsAwaitingAuth}">
      <TextBlock Text="{Binding [Login_Intro], Source={x:Static loc:Localizer.Instance}}"
                 TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.8"/>
      <Button Content="{Binding [Login_Start], Source={x:Static loc:Localizer.Instance}}"
              Command="{Binding StartCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    </StackPanel>

    <!-- После старта: ждём подтверждения в браузере -->
    <StackPanel Spacing="12" IsVisible="{Binding IsAwaitingAuth}">
      <ProgressBar IsIndeterminate="True" Height="4"/>
      <TextBlock Text="{Binding [Login_Waiting], Source={x:Static loc:Localizer.Instance}}"
                 TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                  IsVisible="{Binding UserCode, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding [Login_CodeLabel], Source={x:Static loc:Localizer.Instance}}" Opacity="0.7"/>
        <TextBlock Text="{Binding UserCode}" FontFamily="monospace" FontSize="18" FontWeight="Bold"/>
      </StackPanel>

      <!-- Запасной путь: если браузер не открылся, ссылку видно и её можно выделить/скопировать -->
      <StackPanel x:Name="LoginUrlBlock" Spacing="6"
                  IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding [Login_UrlLabel], Source={x:Static loc:Localizer.Instance}}"
                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.7"/>
        <SelectableTextBlock Text="{Binding Url}" TextWrapping="Wrap"
                             FontFamily="monospace" FontSize="12" HorizontalAlignment="Center"
                             TextAlignment="Center"/>
        <Button Content="{Binding [Login_CopyUrl], Source={x:Static loc:Localizer.Instance}}"
                Command="{Binding CopyUrlCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
      </StackPanel>

      <Button Content="{Binding [Login_OpenBrowser], Source={x:Static loc:Localizer.Instance}}"
              Command="{Binding OpenBrowserCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
      <Button Content="{Binding [Login_Cancel], Source={x:Static loc:Localizer.Instance}}"
              Command="{Binding CancelCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    </StackPanel>

    <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
               HorizontalAlignment="Center" TextAlignment="Center"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </StackPanel>
</UserControl>
