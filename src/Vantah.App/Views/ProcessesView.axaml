<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantah.App.ViewModels"
             xmlns:loc="clr-namespace:Vantah.App.Localization"
             x:DataType="vm:ProcessesViewModel"
             x:Class="Vantah.App.Views.ProcessesView">
  <UserControl.Styles>
    <!-- Убираем собственный отступ строки списка, чтобы колонки строк совпали с шапкой. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="6,0"/>
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="12">

    <!-- Шапка: те же ColumnDefinitions, что и у строки списка; отступ 4 слева/справа
         компенсирует Padding="4,2" строки шаблона. Колонки не Auto: две сетки (шапка и строка)
         посчитали бы Auto по своему содержимому и разъехались. Числа подобраны по самому
         длинному переводу — «Запущен» → pl «Uruchomiono», «Kill» → tr «Sonlandır»; в 90 и 70
         подписи обрезались. Ширины стережёт TranslatedTextFitsTests. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="80,*,120,100" Margin="4,0,4,4">
      <TextBlock Grid.Column="0" Classes="header"
                 Text="{Binding [Processes_Col_Pid], Source={x:Static loc:Localizer.Instance}}"/>
      <TextBlock Grid.Column="1" Classes="header"
                 Text="{Binding [Processes_Col_Command], Source={x:Static loc:Localizer.Instance}}"/>
      <TextBlock Grid.Column="2" Classes="header"
                 Text="{Binding [Processes_Col_Started], Source={x:Static loc:Localizer.Instance}}"/>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="{Binding [Processes_KillAll], Source={x:Static loc:Localizer.Instance}}"
              IsEnabled="{Binding !IsEmpty}">
        <Button.Flyout>
          <Flyout>
            <StackPanel Spacing="8" MaxWidth="260">
              <TextBlock TextWrapping="Wrap"
                         Text="{Binding [Processes_KillAllConfirm], Source={x:Static loc:Localizer.Instance}}"/>
              <Button Content="{Binding [Processes_KillAll], Source={x:Static loc:Localizer.Instance}}"
                      HorizontalAlignment="Right"
                      Command="{Binding KillAllCommand}" Click="OnConfirmClick"/>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Opacity="0.6"
               Text="{Binding [Processes_Empty], Source={x:Static loc:Localizer.Instance}}"
               Margin="6,8,0,0" IsVisible="{Binding IsEmpty}"/>

    <ListBox ItemsSource="{Binding Processes}" Padding="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ProcessRowViewModel">
          <Grid ColumnDefinitions="80,*,120,100" Margin="4,2">
            <TextBlock Grid.Column="0" Text="{Binding Pid}" Margin="6,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding CommandLine}" Margin="6,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CommandLine}"/>
            <TextBlock Grid.Column="2" Text="{Binding StartedAtText}" Opacity="0.7" Margin="6,0"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="3" VerticalAlignment="Center"
                    Content="{Binding [Processes_Kill], Source={x:Static loc:Localizer.Instance}}"
                    Padding="8,2" MinHeight="0">
              <Button.Flyout>
                <Flyout>
                  <StackPanel Spacing="8" MaxWidth="260">
                    <TextBlock Text="{Binding KillConfirmText}" TextWrapping="Wrap"/>
                    <Button Content="{Binding [Processes_KillConfirmAction], Source={x:Static loc:Localizer.Instance}}"
                            HorizontalAlignment="Right"
                            Command="{Binding KillCommand}" Click="OnConfirmClick"/>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
