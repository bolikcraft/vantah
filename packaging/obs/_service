<services>
  <!--
    Воркеры OBS собирают без доступа в сеть, поэтому архив релиза скачивает
    сервис на стороне сервера — при каждом коммите в пакет. Режим не указан
    намеренно: с mode="manual" сервис запускается только локальным osc и при
    заливке через веб-интерфейс не отработал бы вовсе.
  -->
  <service name="download_url">
    <param name="protocol">https</param>
    <param name="host">github.com</param>
    <param name="path">/bolikcraft/vantah/releases/download/v0.3.4/vantah-0.3.4-linux-x64.tar.gz</param>
    <param name="filename">vantah-0.3.4-linux-x64.tar.gz</param>
  </service>

  <!-- Проверяем, что скачали ровно тот файл, чья сумма опубликована в релизе. -->
  <service name="verify_file">
    <param name="file">vantah-0.3.4-linux-x64.tar.gz</param>
    <param name="verifier">sha256</param>
    <param name="checksum">61a56f6bfc12020cc5fa4983cd0ef5f20b0e5b99e4f32f810fe28c472f2bc7e8</param>
  </service>
</services>
