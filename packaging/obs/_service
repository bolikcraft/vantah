<services>
  <!--
    Воркеры OBS собирают без доступа в сеть, поэтому архив релиза скачивает
    сервис на стороне сервера при каждом коммите в пакет. download_files берёт
    URL прямо из Source0 в spec и сохраняет файл под его собственным именем —
    в отличие от download_url, который кладёт результат под служебным
    «_service:download_url:…», из-за чего его не находят ни verify_file, ни сборка.

    Режим не указан намеренно: с mode="manual" сервис запускался бы только
    локальным osc и при заливке через веб-интерфейс не отработал бы вовсе.
  -->
  <service name="download_files"/>
</services>
